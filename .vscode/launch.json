{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "fheroes2 (local GCC)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-local/fheroes2.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "PATH", "value": "${workspaceFolder}/.tools/msys64/ucrt64/bin;${env:PATH}" },
        { "name": "FHEROES2_DATA", "value": "${workspaceFolder}" }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/.tools/msys64/ucrt64/bin/gdb.exe",
      "externalConsole": false,
      "preLaunchTask": "fheroes2: build",
      "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }]
    },
    {
      "name": "fheroes2 (Debug, no optimization)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-debug/fheroes2.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "PATH", "value": "${workspaceFolder}/.tools/msys64/ucrt64/bin;${env:PATH}" },
        { "name": "FHEROES2_DATA", "value": "${workspaceFolder}" }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/.tools/msys64/ucrt64/bin/gdb.exe",
      "externalConsole": false,
      "preLaunchTask": "fheroes2: build Debug",
      "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }]
    }
  ]
}
